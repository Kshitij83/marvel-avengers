# Provider API keys. Leave empty to use the free local Ollama model instead.
# Copy this file to .env (never commit .env). Paste your key after the "=".
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Local free model (no key required). Get a better one:  ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b
